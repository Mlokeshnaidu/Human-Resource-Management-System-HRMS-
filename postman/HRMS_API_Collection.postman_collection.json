          }
        },
        {
          "name": "Onboard New Employee",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"vikram.sharma@hrms.com\",\n  \"password\": \"Welcome@123\",\n  \"role\": \"EMPLOYEE\",\n  \"firstName\": \"Vikram\",\n  \"lastName\": \"Sharma\",\n  \"phone\": \"+1 555-0199\",\n  \"department\": \"Engineering\",\n  \"designation\": \"DevOps Specialist\",\n  \"joiningDate\": \"2026-10-12\",\n  \"baseSalary\": 82000,\n  \"hra\": 24600,\n  \"allowances\": 7500,\n  \"pfDeduction\": 5904,\n  \"taxDeduction\": 5200,\n  \"bankName\": \"HDFC Bank\",\n  \"accountNumber\": \"998877665544\",\n  \"ifscCode\": \"HDFC0001928\",\n  \"emergencyContact\": \"+1 555-0988\",\n  \"address\": \"400 Tech Hub Way, San Francisco, CA\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/employees", "host": ["{{baseUrl}}"], "path": ["api", "employees"] }
          }
        },
        {
          "name": "Update Employee",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"designation\": \"Lead Platform Engineer\",\n  \"baseSalary\": 88000,\n  \"phone\": \"+1 555-0200\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/employees/EMPLOYEE_ID", "host": ["{{baseUrl}}"], "path": ["api", "employees", "EMPLOYEE_ID"] }
          }
        },
        {
          "name": "Toggle Employee Status (Active / Inactive)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/employees/EMPLOYEE_ID/status", "host": ["{{baseUrl}}"], "path": ["api", "employees", "EMPLOYEE_ID", "status"] }
          }
        }
      ]
